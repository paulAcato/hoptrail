# Files and folders that should not end up in the plugin published on
# WordPress.org. The sources in assets/ ship, so the built files can be read
# and rebuilt.
/.distignore
/.editorconfig
/.git
/.github
/.gitattributes
/.gitignore
/.idea
/.prd
/.stylelintrc.json
/.wordpress-org
/composer.json
/composer.lock
/node_modules
/phpcs.xml.dist
/phpstan.neon
/vendor
/.phpstan
/tests
/README.md
/.nvmrc
/bin

# Shipped on purpose (guideline 4): assets/ sources plus package.json, package-lock.json,
# vite.config.ts and tsconfig.json (no .nvmrc: hidden files are not allowed), so the dashboard can be rebuilt from the plugin itself.
