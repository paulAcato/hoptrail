# Files and folders that should not end up in the plugin published on
# WordPress.org. Only what runs on a site ships: the dashboard sources and their
# build configuration live on GitHub (linked from readme.txt), and dist/ is not
# minified, so it stays readable (guideline 4).
/.distignore
/.editorconfig
/.git
/.github
/.gitattributes
/.gitignore
/.idea
/.prd
/.stylelintrc.json
/.wordpress-org
/composer.json
/composer.lock
/node_modules
/phpcs.xml.dist
/phpstan.neon
/vendor
/.phpstan
/tests
/README.md
/.nvmrc
/bin
/assets/scripts
/assets/styles
/package.json
/package-lock.json
/tsconfig.json
/vite.config.ts
