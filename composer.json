{
	"name": "paulacato/hoptrail",
	"description": "Find redirect loops, chains and redirects you don't need across ten SEO and redirect plugins at once.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/paulAcato/hoptrail",
	"authors": [
		{
			"name": "Paul van Impelen",
			"homepage": "https://profiles.wordpress.org/paulacato/"
		}
	],
	"require": {
		"php": ">=8.1",
		"composer/installers": "~1.0 || ~2.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	}
}
