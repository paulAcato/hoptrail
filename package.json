{
  "name": "redirect-inspector",
  "version": "1.0.0",
  "private": true,
  "description": "Redirect Inspector dashboard (React + TypeScript, built with Vite).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "production": "npm run build",
    "watch": "vite build --watch",
    "start": "vite build --watch",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint \"assets/styles/**/*.scss\""
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@wordpress/a11y": "^5.1.0",
    "@wordpress/api-fetch": "^8.1.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/date": "^6.1.0",
    "@wordpress/element": "^10.1.0",
    "@wordpress/i18n": "^7.1.0",
    "@wordpress/icons": "^20.0.0",
    "@wordpress/primitives": "^5.1.0",
    "sass-embedded": "^1.108.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
